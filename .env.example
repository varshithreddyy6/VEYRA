# ══════════════════════════════════════════════════════════════════════════
#  CREDIT CARD FRAUD DETECTION SYSTEM — environment template
#
#  Copy to `.env` at the repository root and adjust for your machine.
#  docker-compose.yml reads this file for container configurations.
#  The backend also loads it directly (python-dotenv) when running locally.
#  NEVER commit a real .env — this file contains development defaults only.
# ══════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────
APP_NAME="Credit Card Fraud Detection System"
ENVIRONMENT=development
DEBUG=true

# ── Security ──────────────────────────────────────────────────────────────
# Generate your own with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production-9f2c1e7a6b4d
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────
# Local (PostgreSQL 16) — used by `make db-start` / manual local Postgres
DATABASE_URL=postgresql+psycopg://fraud:fraud_dev_password@localhost:5432/fraud_detector
# Inside docker-compose the API/worker containers connect via:
# DATABASE_URL=postgresql+psycopg://fraud:fraud_dev_password@postgres:5432/fraud_detector

# ── Redis / Celery ────────────────────────────────────────────────────────
# Local Redis — used by `make redis-start` / manual local Redis
REDIS_URL=redis://localhost:6379/0
# Inside docker-compose the worker connects via:
# REDIS_URL=redis://redis:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Local Vite dev server:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend (used by docker-compose when building the frontend image) ─────
# The browser reaches the API through this origin. For local `npm run dev`
# leave it unset — Vite proxies /api to http://127.0.0.1:8000 automatically.
VITE_API_BASE_URL=http://localhost:8000

# ── Model / business-cost configuration ───────────────────────────────────
# Cost weights used by the threshold optimizer (see backend/fraud_detector/evaluation/threshold.py)
FP_COST=1.0
FN_COST=5.0

# Optional: pin the active model version loaded by the API.
# Leave empty to use the latest version found in artifacts/models/.
MODEL_VERSION=

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_SCREEN_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=20

# ── Upload limits ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=20
BATCH_CHUNK_SIZE=500
